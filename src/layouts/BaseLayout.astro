---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Analytics from '../components/seo/Analytics.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { withBase } from '../lib/url';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Social preview image path in public/. */
  image?: string;
  noindex?: boolean;
  jsonLd?: object;
}

const { title, description, image, noindex = false, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fdfdf8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO title={title} description={description} image={image} noindex={noindex} />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-hand" preload={[{ weight: 400, subset: 'latin' }]} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
