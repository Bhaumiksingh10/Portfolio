---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/ui/PageHead.astro';
import { site } from '../data/site';
import { nextSteps } from '../data/contact';
import { withBase } from '../lib/url';
---

<BaseLayout title="Thanks for your message" description="Your message has been sent." noindex>
  <PageHead
    label="Message sent"
    page="07"
    title="Thanks, your message *is on its way!*"
    lead={`I'll read it and reply ${site.availability.responseTime}. Here's what happens next:`}
  >
    <ol class="steps">
      {
        nextSteps.map((step, index) => (
          <li class={`sticky ${index === 1 ? 'sticky--mint' : index === 2 ? 'sticky--pink' : ''}`}>
            <strong>
              {index + 1}. {step.title}
            </strong>
            <span>{step.text}</span>
          </li>
        ))
      }
    </ol>
    <div class="btn-row">
      <a class="btn btn-primary" href={withBase('/work/')}>See my work</a>
      <a class="pen-link" href={withBase('/')}>back to the home page</a>
    </div>
    <p class="fallback">
      Forgot something? Email me at <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </PageHead>
</BaseLayout>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin: 36px 0 34px;
    max-width: 920px;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 17px;
  }
  .steps li:nth-child(1) {
    transform: rotate(-1.5deg);
  }
  .steps li:nth-child(2) {
    transform: rotate(1deg);
  }
  .steps li:nth-child(3) {
    transform: rotate(-0.6deg);
  }
  .steps strong {
    font-size: 20px;
  }
  .fallback {
    margin-top: 24px;
    color: var(--ink-2);
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
