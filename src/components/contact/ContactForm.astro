---
import Icon from '../ui/Icon.astro';
import CopyEmail from '../ui/CopyEmail.astro';
import { site } from '../../data/site';
import { services } from '../../data/services';
import { budgets, timelines } from '../../data/contact';
import { absoluteUrl } from '../../lib/url';

const { accessKey, hcaptcha } = site.web3forms;
const { responseTime } = site.availability;
if (!accessKey) {
  console.warn('[contact] No Web3Forms access key in src/data/site.ts: showing email links instead of the form.');
}
---

{
  accessKey ? (
    <>
      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST" data-contact-form data-email={site.email}>
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="New project inquiry from your portfolio" />
        <input type="hidden" name="from_name" value="Portfolio contact form" />
        <input type="hidden" name="redirect" value={absoluteUrl('/thanks/')} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" style="display: none" />

        <p class="form-note">
          Fields marked <span class="req">*</span> are required.
        </p>

        <div class="form-grid">
          <div class="field">
            <label for="cf-name">
              Your name<span class="req" aria-hidden="true">*</span>
            </label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="cf-name-error" />
            <p class="field-error" id="cf-name-error" />
          </div>

          <div class="field">
            <label for="cf-email">
              Email<span class="req" aria-hidden="true">*</span>
            </label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="cf-email-error" />
            <p class="field-error" id="cf-email-error" />
          </div>

          <div class="field field--full">
            <label for="cf-company">
              Company or website <span class="opt">(optional)</span>
            </label>
            <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="200" />
          </div>

          <div class="field">
            <label for="cf-service">
              What do you need?<span class="req" aria-hidden="true">*</span>
            </label>
            <select id="cf-service" name="service" required aria-describedby="cf-service-error">
              <option value="">Choose one…</option>
              {services.map((service) => (
                <option value={service.title} data-id={service.id}>
                  {service.title}
                </option>
              ))}
              <option value="Not sure / something else">Not sure / something else</option>
              <option value="Joining a Giving Back drive" data-id="volunteer">I'd like to join a Giving Back drive</option>
            </select>
            <p class="field-error" id="cf-service-error" />
          </div>

          <div class="field">
            <label for="cf-budget">
              Budget <span class="opt">(optional)</span>
            </label>
            <select id="cf-budget" name="budget">
              <option value="">Select a range…</option>
              {budgets.map((budget) => (
                <option value={budget}>{budget}</option>
              ))}
            </select>
          </div>

          <div class="field field--full">
            <label for="cf-timeline">
              Timeline <span class="opt">(optional)</span>
            </label>
            <select id="cf-timeline" name="timeline">
              <option value="">When would you like to start?</option>
              {timelines.map((timeline) => (
                <option value={timeline}>{timeline}</option>
              ))}
            </select>
          </div>

          <div class="field field--full">
            <label for="cf-message">
              Tell me about your project<span class="req" aria-hidden="true">*</span>
            </label>
            <textarea
              id="cf-message"
              name="message"
              rows="6"
              required
              minlength="20"
              maxlength="5000"
              aria-describedby="cf-message-hint cf-message-error"
              placeholder="What are you building, what exists today, and how can I help?"
            />
            <p class="field-hint" id="cf-message-hint">
              Links, deadlines and any existing code or designs help me give you a useful reply.
            </p>
            <p class="field-error" id="cf-message-error" />
          </div>
        </div>

        {hcaptcha && <div class="h-captcha" data-captcha="true" />}

        <div class="form-error" role="alert" data-form-error hidden />

        <div class="form-actions">
          <button class="btn btn-primary btn-lg" type="submit" data-submit>
            <span data-submit-label>Send message</span>
            <Icon name="arrow-right" />
          </button>
          <p class="privacy">
            Sent straight to my inbox via Web3Forms. I never share your details or add you to a mailing list.
          </p>
        </div>
      </form>

      <div class="form-success" data-form-success tabindex="-1" hidden>
        <span class="stamp">
          <Icon name="check" />
        </span>
        <h2>Thanks, your message is on its way!</h2>
        <p>
          I'll reply {responseTime}. If it's urgent, you can also email me at{' '}
          <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-form-status />

      {hcaptcha && <script is:inline src="https://web3forms.com/client/script.js" async defer />}
    </>
  ) : (
    <div class="form-fallback">
      <span class="stamp">
        <Icon name="mail" />
      </span>
      <h2>Email me about your project</h2>
      <p>
        Tell me what you're building, what exists today, your timeline and a rough budget. I'll reply {responseTime}.
      </p>
      <a class="btn btn-primary btn-lg" href={`mailto:${site.email}?subject=${encodeURIComponent('Project inquiry')}`}>
        <Icon name="mail" />
        Email me
      </a>
      <CopyEmail />
    </div>
  )
}

<script>
  import { initContactForm } from '../../scripts/contact-form';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) initContactForm(form);
</script>

<style>
  .form-note {
    font-size: 13.5px;
    color: var(--ink-3);
    margin-bottom: 20px;
  }
  .req {
    color: var(--pen);
    margin-left: 2px;
  }
  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .field--full {
    grid-column: 1 / -1;
  }
  .form-error {
    margin-top: 20px;
    padding: 14px 16px;
    border-left: 4px solid var(--error);
    background: var(--note-pink);
    font-size: 14.5px;
  }
  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 24px;
  }
  .form-actions .btn[disabled] {
    opacity: 0.7;
    cursor: progress;
    transform: none;
  }
  .privacy {
    flex: 1 1 240px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  .stamp {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 2px solid var(--pen);
    border-radius: 50%;
    color: var(--pen);
    transform: rotate(-8deg);
  }
  .form-success,
  .form-fallback {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 12px 0;
  }
  .form-success:focus {
    outline: none;
  }
  .form-success h2,
  .form-fallback h2 {
    font-size: 1.6rem;
    font-weight: 850;
    font-stretch: 112%;
  }
  .form-success p,
  .form-fallback p {
    color: var(--ink-2);
    max-width: 52ch;
  }
  @media (max-width: 600px) {
    .form-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
