---
import { Picture } from 'astro:assets';
import portrait from '../../assets/portrait.png';

interface Props {
  /** polaroid: taped photo with a handwritten caption. avatar: small round photo. */
  variant?: 'polaroid' | 'avatar';
  caption?: string;
  /** Load eagerly with high priority (above-the-fold only). */
  priority?: boolean;
}

const { variant = 'polaroid', caption = "that's me!", priority = false } = Astro.props;
const isPolaroid = variant === 'polaroid';
---

{
  isPolaroid ? (
    <figure class="polaroid taped portrait-polaroid">
      <Picture
        src={portrait}
        alt="Bhaumik Singh Chauhan"
        formats={['webp']}
        fallbackFormat="jpg"
        width={720}
        widths={[320, 480, 720]}
        sizes="(max-width: 920px) 70vw, 330px"
        quality={74}
        priority={priority}
      />
      <figcaption>{caption}</figcaption>
    </figure>
  ) : (
    <div class="avatar">
      <Picture
        src={portrait}
        alt="Bhaumik Singh Chauhan"
        formats={['webp']}
        fallbackFormat="jpg"
        width={256}
        widths={[128, 256]}
        sizes="112px"
        quality={70}
      />
    </div>
  )
}

<style>
  .portrait-polaroid {
    margin: 0;
  }
  .portrait-polaroid :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .avatar {
    width: 112px;
    height: 112px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--card);
    box-shadow: 0 0 0 1.5px var(--ink), var(--shadow-paper);
    background: var(--card);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 14%;
  }
</style>
