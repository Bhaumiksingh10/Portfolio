---
import { icons, type IconName } from '../../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  /** Accessible name. Omit for decorative icons (hidden from screen readers). */
  label?: string;
}

const { name, class: className, label } = Astro.props;
const icon: { body: string; fill?: boolean } = icons[name];
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? undefined : 'currentColor'}
  stroke-width={icon.fill ? undefined : 2}
  stroke-linecap={icon.fill ? undefined : 'round'}
  stroke-linejoin={icon.fill ? undefined : 'round'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={icon.body}
/>
