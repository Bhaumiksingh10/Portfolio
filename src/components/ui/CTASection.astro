---
import Icon from './Icon.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/url';

interface Props {
  title?: string;
  text?: string;
}

const { status, nextOpening, responseTime } = site.availability;
const booked = status === 'booked';
const {
  title = booked ? "I'm booked right now, but let's talk" : 'Got a project in mind?',
  text = booked
    ? `I'm not starting new projects at the moment${nextOpening ? ` (${nextOpening})` : ''}. Send me the details anyway and I'll reply ${responseTime}.`
    : `Tell me what you're building. I'll reply ${responseTime} with questions, ideas or a quick plan.`,
} = Astro.props;
---

<section class="section cta-section">
  <div class="wrap">
    <div class="cta sticky taped">
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={withBase('/contact/')}>
          {booked ? 'Get in touch' : 'Start a project'}
          <Icon name="arrow-right" />
        </a>
        <a class="pen-link" href={`mailto:${site.email}`}>or just email me</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    max-width: 720px;
    padding: 44px 40px 40px;
    transform: rotate(-0.8deg);
    font-family: var(--font-sans, system-ui, sans-serif);
  }
  h2 {
    font-size: clamp(1.9rem, 4.4vw, 2.8rem);
    font-weight: 850;
    font-stretch: 115%;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  p {
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
    max-width: 50ch;
    margin-bottom: 26px;
  }
  @media (max-width: 600px) {
    .cta {
      padding: 36px 22px 28px;
      transform: none;
    }
  }
</style>
