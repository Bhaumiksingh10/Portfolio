---
import Icon from '../ui/Icon.astro';
import { site, whatsappUrl } from '../../data/site';
import { withBase } from '../../lib/url';

const year = new Date().getFullYear();
const links = [
  { href: withBase('/'), label: 'Home' },
  { href: withBase('/work/'), label: 'Work' },
  { href: withBase('/services/'), label: 'Services' },
  { href: withBase('/giving-back/'), label: 'Giving back' },
  { href: withBase('/resume/'), label: 'Resume' },
  { href: withBase('/contact/'), label: 'Contact' },
];
const whatsapp = whatsappUrl();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="end hand">that's the end of this page :)</p>
    <div class="footer-grid">
      <div>
        <a class="f-name" href={withBase('/')}>{site.name}</a>
        <p class="f-sub">{site.tagline}</p>
      </div>
      <nav aria-label="Footer">
        <ul class="footer-links">
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="foot-socials">
        <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)">
          <Icon name="linkedin" />
        </a>
        <a href={site.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub (opens in a new tab)">
          <Icon name="github" />
        </a>
        <a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}>
          <Icon name="mail" />
        </a>
        {
          whatsapp && (
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp (opens in a new tab)">
              <Icon name="whatsapp" />
            </a>
          )
        }
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {year} {site.name}</p>
      <p>Written in {site.location} · {site.timezone}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 40px;
    padding-bottom: 28px;
  }
  .end {
    font-size: 21px;
    padding: 18px 0 26px;
    transform: rotate(-1deg);
    transform-origin: left;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.3fr) auto;
    gap: 26px 40px;
    align-items: start;
    padding: 26px 0;
    border-top: 2px solid var(--ink);
  }
  .f-name {
    font-weight: 800;
    font-stretch: 110%;
    font-size: 18px;
  }
  .f-sub {
    margin-top: 4px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .footer-links a {
    font-size: 13px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer-links a:hover {
    color: var(--pen);
  }
  .foot-socials {
    display: flex;
    gap: 10px;
  }
  .foot-socials a {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--card);
    border: 2px solid var(--ink);
    border-radius: 4px;
    box-shadow: 2px 2px 0 var(--ink);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .foot-socials a:hover {
    color: var(--pen);
    transform: translate(-1px, -1px);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 20px;
    font-size: 13.5px;
    color: var(--ink-3);
  }
  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
